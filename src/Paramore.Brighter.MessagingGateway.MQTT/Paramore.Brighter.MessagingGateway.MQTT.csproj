<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>MQTT messaging gateway implementation for Paramore.Brighter Command Processor. Provides decoupled message transport using MQTT protocol with support for topics, QoS levels, and secure connections.</Description>
    <Authors>Tim van Wijk</Authors>
    <TargetFrameworks>$(BrighterCoreTargetFrameworks)</TargetFrameworks>
    <PackageTags>MQTT;Message Gateway;Command;Event;Service Activator;Decoupled;Invocation;Messaging;Remote;Command Dispatcher;Command Processor;Request;Service;Task Queue;Work Queue;Retry;Circuit Breaker;Availability;Brighter</PackageTags>
    <!-- MQTTnet is not strong-named, so this assembly cannot be signed -->
    <SignAssembly>false</SignAssembly>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Paramore.Brighter\Paramore.Brighter.csproj"/>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MQTTnet"/>
  </ItemGroup>
  <ItemGroup>
    <!-- The arrival handler is a lambda over an MQTTnet client the consumer constructs itself, so
         the payload it cannot read is otherwise reachable only by publishing one through a broker.
         Exposing the deserialisation step lets `mqtt-ci` cover it without standing one up. Note the
         covering test still carries [Trait("Category", "MQTT")]: mqtt-ci filters on Category=MQTT,
         and the `build` job runs an explicit list of four projects that does not include this one,
         so a test here without that trait runs in NEITHER job. This assembly is already unsigned
         (see SignAssembly above), so no strong-name key is involved. -->
    <InternalsVisibleTo Include="Paramore.Brighter.MQTT.Tests" />
  </ItemGroup>
</Project>
