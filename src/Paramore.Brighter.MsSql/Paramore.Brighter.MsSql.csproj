<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Microsoft SQL Server provider for Paramore.Brighter Command Processor. Provides common components for connecting to SQL Server, including connection and transaction management for inbox, outbox, and messaging gateway implementations.</Description>
    <Authors>Paul Reardon</Authors>
    <TargetFrameworks>$(BrighterFrameworkAndCoreTargetFrameworks)</TargetFrameworks>
    <PackageTags>SQL Server;MSSQL;Database;Connection Provider;Transaction;Command;Event;Command Processor;Brighter</PackageTags>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- Lifts Microsoft.Data.SqlClient's transitive Pkcs past GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paramore.Brighter\Paramore.Brighter.csproj" />
  </ItemGroup>

</Project>
