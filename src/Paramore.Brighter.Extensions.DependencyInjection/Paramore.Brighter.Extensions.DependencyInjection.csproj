<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Microsoft.Extensions.DependencyInjection integration for Paramore.Brighter Command Processor. Provides dependency injection container support for registering handlers, policies, and framework components.</Description>
    <Authors>Daniel Stockhammer, Toby Henderson</Authors>
    <TargetFrameworks>$(BrighterTargetFrameworks)</TargetFrameworks>
    <PackageTags>Dependency Injection;DI;Container;Command;Event;Command Processor;Microsoft Extensions;Brighter</PackageTags>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Options"/>
    <PackageReference Include="System.Text.Json"/>
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
    <!-- ServiceProviderLifetimeScope disposes IAsyncDisposable service scopes on every TFM. IAsyncDisposable
         (Microsoft.Bcl.AsyncInterfaces) and ValueTask (System.Threading.Tasks.Extensions) are not in the
         netstandard2.0 BCL; reference them explicitly rather than relying on the transitive copy the DI
         abstractions pull in, so a later dependency bump that drops or downgrades them cannot break the
         netstandard2.0 async-disposal path. -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="System.Threading.Tasks.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paramore.Brighter\Paramore.Brighter.csproj"/>
  </ItemGroup>
</Project>
