<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Apache RocketMQ messaging gateway implementation for Paramore.Brighter Command Processor. Provides decoupled message transport using RocketMQ with support for pub/sub patterns and distributed messaging.</Description>
    <TargetFrameworks>$(BrighterCoreTargetFrameworks)</TargetFrameworks>
    <Authors>Rafael Andrade</Authors>
    <PackageTags>RocketMQ;Apache;Message Gateway;Pub/Sub;Command;Event;Service Activator;Decoupled;Invocation;Messaging;Remote;Command Dispatcher;Command Processor;Request;Service;Task Queue;Work Queue;Retry;Circuit Breaker;Availability;Brighter</PackageTags>
    <Nullable>enable</Nullable>
    <!-- RocketMQ.Client is not strong-named, so this assembly cannot be signed -->
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paramore.Brighter\Paramore.Brighter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RocketMQ.Client" />
  </ItemGroup>

  <ItemGroup>
    <!-- rocketmq-ci is commented out in ci.yml, so the generated RocketMQ suite never runs and a
         broker-free test is the only thing that exercises this gateway at all. This assembly is
         already unsigned (see SignAssembly above), so no strong-name key is involved. -->
    <InternalsVisibleTo Include="Paramore.Brighter.RocketMQ.Tests" />
  </ItemGroup>

</Project>
