<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>ASP.NET Core integration for Paramore.Brighter. Offers the current HTTP request's own DI scope as Brighter's ambient scope, so an opted-in pipeline can share it instead of Brighter creating its own.</Description>
    <Authors>Ian Cooper</Authors>
    <TargetFrameworks>$(BrighterCoreTargetFrameworks)</TargetFrameworks>
    <PackageTags>ASP.NET Core;Dependency Injection;DI;Container;Ambient Scope;Request Scope;Command;Event;Command Processor;Brighter</PackageTags>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paramore.Brighter.Extensions.DependencyInjection\Paramore.Brighter.Extensions.DependencyInjection.csproj"/>
  </ItemGroup>
</Project>
