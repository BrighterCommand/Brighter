<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <!-- samples/Directory.Build.props does not import the root one, so samples do not inherit
         <Nullable>enable</Nullable>. SampleDatabase.ConnectionString takes a string?, which is a
         CS8632 warning without this. -->
